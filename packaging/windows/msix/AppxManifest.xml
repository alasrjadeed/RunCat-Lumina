<?xml version="1.0" encoding="utf-8"?>
<!--
  RunCat Lumina MSIX manifest template.

  {{PUBLISHER}} and {{VERSION}} are replaced by packaging/windows/build-msix.ps1
  at build time. For a Microsoft Store submission {{PUBLISHER}} MUST be the exact
  Publisher string shown in Microsoft Partner Center (Account settings), or the
  package upload will be rejected.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/rescap"
  IgnorableNamespaces="uap rescap">

  <Identity
    Name="AlAsarJadeed.RunCatLumina"
    Publisher="{{PUBLISHER}}"
    Version="{{VERSION}}"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>RunCat Lumina</DisplayName>
    <PublisherDisplayName>AL ASAR JADEED</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily
      Name="Windows.Desktop"
      MinVersion="10.0.17763.0"
      MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application
      Id="RunCatLumina"
      Executable="RunCat-Lumina.exe"
      EntryPoint="Windows.fullTrustApplication">
      <uap:VisualElements
        DisplayName="RunCat Lumina"
        Description="A running cat in your taskbar tray. Recolor the sprite and watch its speed follow CPU usage."
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
